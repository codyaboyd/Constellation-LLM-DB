PORT=4317
HOST=0.0.0.0
DATA_DIR=./data

# Dashboard login. On first boot this is hashed with Bun.password and persisted.
CONSTELLATION_PASSWORD=change-me-now
# Or provide an existing Bun/Argon2 compatible hash instead.
# CONSTELLATION_PASSWORD_HASH=

# API auth. If empty, Constellation generates/persists a key and prints it once.
CONSTELLATION_API_KEY=
SESSION_SECRET=replace-with-a-long-random-secret

# Local model runtime. Models are cached on disk and can run with all remote access disabled.
MODEL_CACHE_DIR=./data/model-cache
MODEL_PRELOAD=true
TRANSFORMERS_ALLOW_REMOTE=true
# Optional directory containing pre-provisioned Hugging Face model trees.
# TRANSFORMERS_LOCAL_MODEL_PATH=./models

# Local embedding model through Transformers.js
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DTYPE=q8
EMBEDDING_BATCH_SIZE=16

# Local Jina Reranker Turbo through Transformers.js / ONNX. No Jina API is used.
JINA_RERANKER_MODEL=jinaai/jina-reranker-v1-turbo-en
JINA_RERANKER_DTYPE=q8
JINA_RERANKER_BATCH_SIZE=16
JINA_RERANKER_MAX_TOKENS=8192

# Deployment settings below are imported on first boot and can then be managed from the dashboard Settings screen.
# After they are saved in the dashboard, the persisted database values take precedence over this file.
# standalone | gateway | worker | replica | hybrid
NODE_ROLE=standalone
NODE_NAME=constellation-node
PUBLIC_BASE_URL=http://127.0.0.1:4317

# Set the same value on linked deployments.
CLUSTER_SHARED_SECRET=replace-with-a-long-cluster-secret
# For non-gateway nodes, optionally point to the authoritative gateway.
GATEWAY_URL=

# Gateway compute should be a last resort.
GATEWAY_LOCAL_COMPUTE_PENALTY=10000
WORKER_BASE_PRIORITY=100
PEER_HEARTBEAT_TTL_MS=30000

# Crawl protections
CRAWL_MAX_PAGES=30
CRAWL_MAX_DEPTH=2
CRAWL_MAX_BYTES_PER_PAGE=2000000
ALLOW_PRIVATE_CRAWL=false
